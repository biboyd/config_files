#!/bin/bash

year=`date +%Y`
month=`date +%m`
day=`date +%d`

month_word=`date +%B`

filedir="LBM-${year}-${month}"
filename="${filedir}/notes_${day}.md"

if [ -e "$filename" ]
then
	vim $filename

else
    mkdir -p $filedir
    if [ $day = "01" ] || [ $day = "21" ] || [ $day = "31" ]
	then
        end="st"
    elif [ $day = "02" ] || [ $day = "22" ] 
	then
        end="nd"
    elif [ $day = "03" ] || [ $day = "23" ] 
	then
        end="rd"
    else
        end="th"
    fi
	if [ $day = "01" ] || [ $day = "02" ] || [ $day = "03" ] || [ $day = "04" ] || [ $day = "05" ] || [ $day = "06" ] || [ $day = "07" ] || [ $day = "08" ] || [ $day = "09" ]
	then
		niceday="${day:1:1}${end}"
	else
		niceday="${day}${end}"
	fi
	echo "# $month_word $niceday $year" > $filename
	vim $filename
fi
